{
  "name": "connections-ui",
  "version": "1.22.0",
  "description": "UI for Common Threads",
  "author": "David Bowland",
  "engines": {
    "node": "^24.0.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidbowland/connections-ui.git"
  },
  "bugs": {
    "url": "https://github.com/davidbowland/connections-ui/issues"
  },
  "homepage": "https://github.com/davidbowland/connections-ui#readme",
  "scripts": {
    "build": "npm run clean && next build",
    "postbuild": "node scripts/generate-dynamic-pages.js && next-sitemap",
    "clean": "rm -rf .next coverage out && npm ci --legacy-peer-deps",
    "deploy": "DEVELOPMENT=true npm run build && ./scripts/deploy.sh",
    "generate:favicons": "node scripts/generate-favicons.js",
    "lint": "prettier --write . && eslint --fix .",
    "prepare": "husky || true",
    "start": "next dev",
    "serve": "next build && npx serve out",
    "test": "jest --colors",
    "typecheck": "tsc --noEmit",
    "update": "npx update-browserslist-db@latest && ncu --doctor --target minor --upgrade && npm audit fix --audit-level=none && npm run test && npm dedupe"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.2.10",
    "@heroui/react": "^3.2.1",
    "axios": "^1.18.1",
    "framer-motion": "^12.42.0",
    "next": "^15.5.19",
    "next-sitemap": "^4.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.1",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.64.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "prettier --write --ignore-unknown",
      "eslint --fix",
      "jest --colors --findRelatedTests --coverageThreshold '{}' --passWithNoTests"
    ],
    "**/*": [
      "prettier --write --ignore-unknown"
    ]
  }
}
